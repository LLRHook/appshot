		"count_per_device_size": {
			"min": 1,
			"max": 10,
			"verbatim": "You must include at least one screenshot and can upload up to 10 screenshots per device size in .jpeg, .jpg, or .png formats"
		},
		"formats": [".jpeg", ".jpg", ".png"],
		"alpha": {
			"allowed": false,
			"verbatim": "Images can't include alpha channels or transparencies."
		},
		"color_space": {
			"documented": false,
			"note": "No color-space, DPI, bit-depth or file-size limit on this page. 8-bit sRGB RGB is a conservative default, not an Apple-stated rule."
		},
		"orientation": {
			"note": "Portrait and landscape dimensions are listed per class. The page does not state that a set must use one orientation."
		},
		"display_scaling_verbatim": "If your app's user interface is consistent across multiple device sizes and localizations, you only need to provide screenshots for the highest required resolution. App Store Connect automatically scales them down for smaller device sizes.",
