			"mac": ["1280x800", "1440x900", "2560x1600", "2880x1800"],
			"apple_tv": ["1920x1080", "3840x2160"],
			"vision_pro": ["3840x2160"],
			"watch": ["422x514", "410x502", "416x496", "396x484", "368x448", "312x390"]
		},
		"compliance_caveat": "Dimensions are a file-level check only. They do not establish App Review approval, native device UI, or truthful content."
	},
